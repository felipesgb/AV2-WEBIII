{
  "info": {
    "name": "AV3 AutoManager — fluxo completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"Empresa\") { pm.collectionVariables.set(\"sufixo\", Date.now().toString()); pm.collectionVariables.set(\"codigo\", Date.now()); }",
          "if (pm.info.requestName === \"Empresa\") { pm.collectionVariables.set(\"placa\", Array.from({length:3}, () => String.fromCharCode(65 + Math.floor(Math.random()*26))).join(\"\") + Math.floor(1000 + Math.random()*9000)); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Empresa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/empresas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"razaoSocial\": \"AutoBots Demonstração\",\n  \"nomeFantasia\": \"Oficina AV3\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Criado\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"empresaId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ana\",\n  \"perfis\": [\n    \"CLIENTE\"\n  ],\n  \"empresaId\": {{empresaId}}\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Criado\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"clienteId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
