    {
      "name": "Venda",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/vendas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identificacao\": \"VENDA-{{sufixo}}\",\n  \"empresaId\": {{empresaId}},\n  \"clienteId\": {{clienteId}},\n  \"funcionarioId\": {{funcionarioId}},\n  \"veiculoId\": {{veiculoId}},\n  \"mercadoriasIds\": [\n    {{mercadoriaId}}\n  ],\n  \"servicosIds\": [\n    {{servicoId}}\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
